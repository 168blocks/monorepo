# egglog as native code for libs/pgecs-eqsat, generated by Endive's experimental Redline backend
# (Cranelift, itself compiled to JVM bytecode, run at build time): the module class
# dev.vxcc.alexs168.pgecs.eqsat.aot.EgglogNativeModule with its bytecode and one native code file per
# target. Gradle compiles and packages it (libs/pgecs-eqsat/build.gradle.kts, BLOCKS_EGGLOG_REDLINE).
#
# This is slow (~15 min per target for egglog on 4 cores), which is why it is a Nix derivation, cached
# by the Nix store, and not a Gradle task. It reruns only when egglog, the crate or Endive change.
#
# Output: $out/{classes,sources,resources}, as from Endive's build-time compiler.
{
  lib,
  stdenvNoCC,
  fetchurl,
  jdk,
  # egglog built with opt-level 3 (nix/egglog-wasm.nix): native code prefers inlining
  egglogWasm,
  targets ? [
    "x86_64-unknown-linux-gnu"
    "aarch64-unknown-linux-gnu"
  ],
}:
let
  # redline-build-time-compiler-experimental 1.2.0 and its runtime dependencies (Maven Central);
  # keep the version in step with `endive` in gradle/libs.versions.toml
  jar = url: hash: fetchurl { inherit url hash; };
  classpath = [
    (jar "https://repo1.maven.org/maven2/run/endive/redline-build-time-compiler-experimental/1.2.0/redline-build-time-compiler-experimental-1.2.0.jar" "sha256-T3Sagep4LWTJOjJmluNEmhb7HHEMmb1+fNLkuwGCzCo=")
    (jar "https://repo1.maven.org/maven2/com/github/javaparser/javaparser-core/3.28.2/javaparser-core-3.28.2.jar" "sha256-tUmaOxxAsWwGcfq+R4yar+qzgWDG/edKbBP0LYZxbs0=")
    (jar "https://repo1.maven.org/maven2/run/endive/build-time-compiler/1.2.0/build-time-compiler-1.2.0.jar" "sha256-UvcIBoFQCFQV6qExxLn0rTqhoMA7Z5aBqJ1DG9SdJvM=")
    (jar "https://repo1.maven.org/maven2/run/endive/codegen/1.2.0/codegen-1.2.0.jar" "sha256-/q1jJiRQp0GYTGuglppGI06eNzrAn+CQ1gmxU+cbUVM=")
    (jar "https://repo1.maven.org/maven2/run/endive/compiler/1.2.0/compiler-1.2.0.jar" "sha256-7pCXnVmOa4dVfWAU9sIRHSpl07SnHwOy7AigTSi401Q=")
    (jar "https://repo1.maven.org/maven2/org/ow2/asm/asm/9.11.1/asm-9.11.1.jar" "sha256-rk5uENWdChUAMXdkshiBrYg/hVDjPGbmFC9wMsb7Vmw=")
    (jar "https://repo1.maven.org/maven2/org/ow2/asm/asm-commons/9.11.1/asm-commons-9.11.1.jar" "sha256-alCV7FNyYVaniyzS79RbxOh3dU7KfCNPYSJKU9a/pmE=")
    (jar "https://repo1.maven.org/maven2/org/ow2/asm/asm-tree/9.11.1/asm-tree-9.11.1.jar" "sha256-KxXDwbKIqfrTuyzW2Yi6lSFVSRTtHyogKRQfo/SDFUo=")
    (jar "https://repo1.maven.org/maven2/org/ow2/asm/asm-util/9.11.1/asm-util-9.11.1.jar" "sha256-I/3/rN/Dj0R8vYuA4Fj0YkUfpdRwnkNwZ9Uw+mUTV50=")
    (jar "https://repo1.maven.org/maven2/org/ow2/asm/asm-analysis/9.11.1/asm-analysis-9.11.1.jar" "sha256-OpF2kofQoYYzPW44Tl1O7DfkuPcF3Pkg/0rqTMRS+sI=")
    (jar "https://repo1.maven.org/maven2/run/endive/runtime/1.2.0/runtime-1.2.0.jar" "sha256-NgwusW3EPV4Ffd/n0WLM7XAQ0l770yxvhRUCMw1O/mc=")
    (jar "https://repo1.maven.org/maven2/run/endive/redline-api-experimental/1.2.0/redline-api-experimental-1.2.0.jar" "sha256-XLM1YPHKN8KnRvXqjSRnb5/yilKZFBm3+qm3RYOMUZo=")
    (jar "https://repo1.maven.org/maven2/run/endive/redline-compiler-experimental/1.2.0/redline-compiler-experimental-1.2.0.jar" "sha256-1cMtzJ6D2mfbfoiL1q3ZMRlyRlxFZF5E1M6IwBjz+hE=")
    (jar "https://repo1.maven.org/maven2/run/endive/redline-bridge-experimental/1.2.0/redline-bridge-experimental-1.2.0.jar" "sha256-FUH+s5TAHDfvCrZqLsSBLFhUpseGWmmawrkK0YiSKKI=")
    (jar "https://repo1.maven.org/maven2/run/endive/wasi/1.2.0/wasi-1.2.0.jar" "sha256-E45Fx+VivYb1e4dK+FfmuPY1v1PfPq9Cm9b2DWYuRBQ=")
    (jar "https://repo1.maven.org/maven2/run/endive/log/1.2.0/log-1.2.0.jar" "sha256-eKnZUfFVuljTQXyk9zwlHkKbgsp22xn/q7xlaK399OE=")
    (jar "https://repo1.maven.org/maven2/run/endive/wasm/1.2.0/wasm-1.2.0.jar" "sha256-PsB1NHgXFNpK4eNwOwTFUqP5Q6Md4V/LWCIpKagAv+Y=")
  ];
  cp = lib.concatStringsSep ":" classpath;
in
stdenvNoCC.mkDerivation {
  pname = "egglog-redline";
  inherit (egglogWasm) version;
  src = ../libs/pgecs-eqsat/redline;
  nativeBuildInputs = [ jdk ];

  buildPhase = ''
    runHook preBuild
    javac -d gen -cp ${cp} RedlineGen.java
    mkdir -p $out
    java -Xmx4g -XX:-DontCompileHugeMethods -cp gen:${cp} RedlineGen \
      ${egglogWasm}/egglog.wasm dev.vxcc.alexs168.pgecs.eqsat.aot.EgglogNativeModule \
      $out/classes $out/sources $out/resources \
      ${lib.escapeShellArgs targets}
    runHook postBuild
  '';
  dontInstall = true;
  dontFixup = true;

  meta.sourceProvenance = with lib.sourceTypes; [
    fromSource
    binaryBytecode # Endive's jars from Maven Central
  ];
}
